{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Passwords",
  "version": "0.1.0",
  "identifier": "de.tinybrickboy.ncpasswords",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Passwords",
        "width": 980,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "msi", "nsis"],
    "category": "Utility",
    "shortDescription": "Desktop Client für Nextcloud Passwords",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
